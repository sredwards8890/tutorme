# Copy to .env (git-ignored). Values come from the LiveKit Cloud dashboard: Settings > Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Room name shared by both users.
ROOM=tutorme

# Where the spike is served. Links printed by `npm run mint` point here.
#   LAN HTTPS test:  https://<pc-lan-ip>:5174
#   Cross-home:      https://sredwards8890.github.io/tutorme
BASE_URL=http://localhost:5173
