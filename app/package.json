{
  "name": "tutorme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "vite --host --mode https",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "preview": "vite preview --host",
    "mint": "node --env-file-if-exists=.env --env-file-if-exists=../spike/.env scripts/mint-tokens.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "livekit-client": "^2.22.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "livekit-server-sdk": "^2.19.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.4"
  }
}
