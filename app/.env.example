# Copy to .env (git-ignored). If this file is absent, `npm run mint` falls back to ../spike/.env.
# Values come from the LiveKit Cloud dashboard: Settings > Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Room name shared by both users.
ROOM=tutorme

# Where the app is served. Links printed by `npm run mint` point here.
#   Local dev:       http://localhost:5180
#   LAN HTTPS test:  https://<pc-lan-ip>:5181
#   Deployed:        https://sredwards8890.github.io/tutorme
BASE_URL=https://sredwards8890.github.io/tutorme
